<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PlayerRound">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/player_round</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:fontVariationSettings">\'wght\' 800</item>
        <item name="android:textColor">@color/player_pill_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PlayerPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:background">@drawable/player_pill</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="PlayerPillLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:fontVariationSettings">\'wght\' 800</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/player_pill_label</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="PlayerPillValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:fontVariationSettings">\'wght\' 700</item>
        <item name="android:maxLines">1</item>
        <item name="android:maxWidth">230dp</item>
        <item name="android:textColor">@color/player_pill_text</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
